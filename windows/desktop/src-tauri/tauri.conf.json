{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VisionEval Workbench",
  "version": "1.0.0",
  "identifier": "com.visioneval.workbench",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "npm run build:backend"
  },
  "app": {
    "windows": [{
      "title": "VisionEval Workbench",
      "width": 1540,
      "height": 980,
      "minWidth": 1120,
      "minHeight": 760
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/visioneval-workbench-backend"],
    "resources": [],
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
