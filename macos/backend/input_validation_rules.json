{
  "version": 1,
  "defaults": {
    "numericMinimum": 0,
    "fractionPrecision": 6,
    "groupTolerance": 0.000001
  },
  "fractionPatterns": [
    "prop",
    "^(FwySmooth|ArtSmooth|LdvEcoDrive|HvyTrkEcoDrive)$"
  ],
  "files": {
    "other_ops_effectiveness.csv": {
      "columns": {
        "Level": {"kind": "protected", "reason": "Structural effectiveness row key"}
      }
    },
    "marea_base_year_dvmt.csv": {
      "columns": {
        "UzaNameLookup": {"kind": "protected", "reason": "Runtime lookup key"}
      }
    },
    "region_base_year_dvmt.csv": {
      "columns": {
        "StateAbbrLookup": {"kind": "protected", "reason": "Runtime lookup key"},
        "HvyTrkDvmtGrowthBasis": {"kind": "protected", "reason": "Runtime growth-basis identifier"},
        "ComSvcDvmtGrowthBasis": {"kind": "protected", "reason": "Runtime growth-basis identifier"}
      }
    },
    "bzone_lat_lon.csv": {
      "columns": {
        "Latitude": {"minimum": -90, "maximum": 90, "bulkEditable": false, "directEditable": true, "precision": 6, "reason": "Latitude can only be corrected directly"},
        "Longitude": {"minimum": -180, "maximum": 180, "bulkEditable": false, "directEditable": true, "precision": 6, "reason": "Longitude can only be corrected directly"}
      }
    },
    "bzone_hh_inc_qrtl_prop.csv": {
      "groups": [
        {"id": "household-income-quartiles", "members": ["HhPropIncQ1", "HhPropIncQ2", "HhPropIncQ3", "HhPropIncQ4"], "rule": "sum_equals", "target": 1}
      ]
    },
    "marea_dvmt_split_by_road_class.csv": {
      "groups": [
        {"id": "light-duty-road-class", "members": ["LdvFwyDvmtProp", "LdvArtDvmtProp", "LdvOthDvmtProp"], "rule": "sum_equals", "target": 1},
        {"id": "heavy-truck-road-class", "members": ["HvyTrkFwyDvmtProp", "HvyTrkArtDvmtProp", "HvyTrkOthDvmtProp"], "rule": "sum_equals", "target": 1},
        {"id": "bus-road-class", "members": ["BusFwyDvmtProp", "BusArtDvmtProp", "BusOthDvmtProp"], "rule": "sum_equals", "target": 1}
      ]
    },
    "marea_transit_fuel.csv": {
      "groups": [
        {"id": "van-transit-fuel", "members": ["VanPropDiesel", "VanPropGasoline", "VanPropCng"], "rule": "sum_equals", "target": 1},
        {"id": "bus-transit-fuel", "members": ["BusPropDiesel", "BusPropGasoline", "BusPropCng"], "rule": "sum_equals", "target": 1},
        {"id": "rail-transit-fuel", "members": ["RailPropDiesel", "RailPropGasoline"], "rule": "sum_equals", "target": 1, "optional": true}
      ]
    },
    "marea_transit_powertrain_prop.csv": {
      "groups": [
        {"id": "van-transit-powertrain", "members": ["VanPropIcev", "VanPropHev", "VanPropBev"], "rule": "sum_equals", "target": 1},
        {"id": "bus-transit-powertrain", "members": ["BusPropIcev", "BusPropHev", "BusPropBev"], "rule": "sum_equals", "target": 1},
        {"id": "rail-transit-powertrain", "members": ["RailPropIcev", "RailPropHev", "RailPropEv"], "rule": "sum_equals", "target": 1, "optional": true}
      ]
    },
    "region_carsvc_powertrain_prop.csv": {
      "groups": [
        {"id": "car-service-auto-powertrain", "members": ["CarSvcAutoPropIcev", "CarSvcAutoPropHev", "CarSvcAutoPropBev"], "rule": "sum_equals", "target": 1},
        {"id": "car-service-light-truck-powertrain", "members": ["CarSvcLtTrkPropIcev", "CarSvcLtTrkPropHev", "CarSvcLtTrkPropBev"], "rule": "sum_equals", "target": 1}
      ]
    },
    "region_comsvc_powertrain_prop.csv": {
      "groups": [
        {"id": "commercial-service-auto-powertrain", "members": ["ComSvcAutoPropIcev", "ComSvcAutoPropHev", "ComSvcAutoPropBev"], "rule": "sum_equals", "target": 1},
        {"id": "commercial-service-light-truck-powertrain", "members": ["ComSvcLtTrkPropIcev", "ComSvcLtTrkPropHev", "ComSvcLtTrkPropBev"], "rule": "sum_equals", "target": 1}
      ]
    },
    "region_hvytrk_powertrain_prop.csv": {
      "groups": [
        {"id": "heavy-truck-powertrain", "members": ["HvyTrkPropIcev", "HvyTrkPropHev", "HvyTrkPropBev"], "rule": "sum_equals", "target": 1}
      ]
    },
    "bzone_urban-town_du_proportions.csv": {
      "groups": [
        {"id": "single-family-location-shares", "members": ["PropUrbanSFDU", "PropTownSFDU"], "rule": "sum_at_most", "target": 1, "remainderLabel": "Rural share"},
        {"id": "multi-family-location-shares", "members": ["PropUrbanMFDU", "PropTownMFDU"], "rule": "sum_at_most", "target": 1, "remainderLabel": "Rural share"},
        {"id": "group-quarters-location-shares", "members": ["PropUrbanGQDU", "PropTownGQDU"], "rule": "sum_at_most", "target": 1, "remainderLabel": "Rural share"}
      ]
    }
  }
}
