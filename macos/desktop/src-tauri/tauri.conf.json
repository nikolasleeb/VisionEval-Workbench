{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VisionEval Workbench",
  "version": "2.0.0",
  "identifier": "com.visioneval.workbench",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "npm run build:backend"
  },
  "app": {
    "windows": [{
      "title": "VisionEval Workbench",
      "width": 1540,
      "height": 980,
      "minWidth": 1120,
      "minHeight": 700,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/visioneval-workbench-backend"],
    "resources": [],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "Developer ID Application: Nikolas Lee-Bishop (R5T9LB7RHK)",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    }
  }
}
